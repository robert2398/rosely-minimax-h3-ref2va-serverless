# Vast template / serverless
SERVERLESS=true
PYWORKER_REPO=https://github.com/robert2398/rosely-minimax-h3-ref2va-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/robert2398/rosely-minimax-h3-ref2va-serverless/main/provision.sh

# AWS credentials.
# Keep standard AWS names because boto3's credential chain expects them.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# AWS_SESSION_TOKEN=only_if_using_temporary_credentials

# ---------------------------------------------------------------------------
# Rosely H3 model storage.
# These names are intentionally namespaced to avoid collisions with generic
# S3_BUCKET / S3_REGION variables injected by Vast or sourced from .env files.
# ---------------------------------------------------------------------------
ROSELY_H3_S3_BUCKET=rosely-infrastructure
ROSELY_H3_S3_REGION=us-east-1
ROSELY_H3_S3_MODEL_KEY=models/minimax-h3/rosely-h3-ref2va-quality-5090.zip
ROSELY_H3_S3_CHECKSUM_KEY=models/minimax-h3/rosely-h3-ref2va-quality-5090.zip.sha256

# Leave blank for normal AWS S3.
ROSELY_H3_S3_ENDPOINT_URL=

# Model artifact download tuning
ROSELY_H3_S3_DOWNLOAD_CONCURRENCY=16
ROSELY_H3_S3_DOWNLOAD_CHUNK_MIB=64

# Generated video output
ROSELY_H3_OUTPUT_BUCKET=rosely-infrastructure
ROSELY_H3_OUTPUT_PREFIX=generated/minimax-h3
ROSELY_H3_PRESIGNED_URL_EXPIRES_SECONDS=3600

# Provisioning/runtime
MIN_FREE_DISK_GB=85
GENERATION_TIMEOUT_SECONDS=3600
KEEP_LOCAL_OUTPUTS=false
MAX_INPUT_IMAGE_BYTES=31457280
LOG_LEVEL=INFO

# Quality-first 5090 setup
COMFYUI_ARGS=
