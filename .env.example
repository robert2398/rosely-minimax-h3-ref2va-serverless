# Vast template
SERVERLESS=true

# Push this repository first, then set these two URLs.
PYWORKER_REPO=https://github.com/YOUR_GITHUB_USER/rosely-h3-ref2va-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/YOUR_GITHUB_USER/rosely-h3-ref2va-serverless/main/provision.sh

# AWS credentials: configure these as Vast secrets, NOT in Git.
AWS_ACCESS_KEY_ID=replace_in_vast_secret
AWS_SECRET_ACCESS_KEY=replace_in_vast_secret
# AWS_SESSION_TOKEN=only_if_using_temporary_credentials

# H3 model artifact in AWS S3
S3_BUCKET=rosely-infrastructure
S3_REGION=us-east-1
S3_MODEL_KEY=models/minimax-h3/rosely-h3-ref2va-quality-5090.zip
S3_CHECKSUM_KEY=models/minimax-h3/rosely-h3-ref2va-quality-5090.zip.sha256

# Optional: only for non-AWS S3-compatible storage.
S3_ENDPOINT_URL=

# Artifact download tuning
S3_DOWNLOAD_CONCURRENCY=16
S3_DOWNLOAD_CHUNK_MIB=64

# Disk: ZIP + extracted models coexist briefly.
MIN_FREE_DISK_GB=85

# Quality-first 5090 setup: use ComfyUI DynamicVRAM defaults first.
# Leave blank initially. If a specific host OOMs, test --lowvram.
COMFYUI_ARGS=
