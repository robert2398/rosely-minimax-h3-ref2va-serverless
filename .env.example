# Vast template / serverless
SERVERLESS=true
PYWORKER_REPO=https://github.com/robert2398/rosely-minimax-h3-ref2va-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/robert2398/rosely-minimax-h3-ref2va-serverless/main/provision.sh

# AWS credentials: configure as Vast account/template secrets, never commit actual values.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# AWS_SESSION_TOKEN=only_if_using_temporary_credentials

# Model artifact
S3_BUCKET=rosely-infrastructure
S3_REGION=us-east-1
S3_MODEL_KEY=models/minimax-h3/rosely-h3-ref2va-quality-5090.zip
S3_CHECKSUM_KEY=models/minimax-h3/rosely-h3-ref2va-quality-5090.zip.sha256

# Generated video output.
# Defaults to S3_BUCKET if S3_OUTPUT_BUCKET is omitted.
S3_OUTPUT_BUCKET=rosely-infrastructure
S3_OUTPUT_PREFIX=generated/minimax-h3
S3_PRESIGNED_URL_EXPIRES_SECONDS=3600

# Leave blank for normal AWS S3.
S3_ENDPOINT_URL=

# Provisioning/download tuning
S3_DOWNLOAD_CONCURRENCY=16
S3_DOWNLOAD_CHUNK_MIB=64
MIN_FREE_DISK_GB=85

# Runtime
GENERATION_TIMEOUT_SECONDS=3600
KEEP_LOCAL_OUTPUTS=false
MAX_INPUT_IMAGE_BYTES=31457280
LOG_LEVEL=INFO

# Quality-first 5090 setup. Start with ComfyUI's normal DynamicVRAM behavior.
COMFYUI_ARGS=
